# --- App ---
PORT=5000
NODE_ENV=development
# Public URL of THIS deployed API (no trailing slash). QStash calls back to
# ${APP_URL}/api/send-email at the exact scheduled time, so this must be
# reachable from the internet — localhost will not work for testing
# scheduled sends locally (use a tunnel, see README).
APP_URL=https://your-api.vercel.app
# URL of the deployed React frontend — used for CORS and post-login redirect
CLIENT_URL=http://localhost:5173

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/email_scheduler?retryWrites=true&w=majority

# --- Auth ---
# Generate with: openssl rand -base64 32
JWT_SECRET=

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- Gemini API (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Upstash QStash (https://console.upstash.com/qstash) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Refresh token encryption ---
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
